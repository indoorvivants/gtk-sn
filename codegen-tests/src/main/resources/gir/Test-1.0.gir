<?xml version="1.0" ?>
<repository
    xmlns="http://www.gtk.org/introspection/core/1.0"
    xmlns:c="http://www.gtk.org/introspection/c/1.0"
    xmlns:glib="http://www.gtk.org/introspection/glib/1.0"
    version="1.2"
>
  <package name="codegen_tests" />
  <namespace
        name="CodegenTests"
        version="4.0"
        shared-library="libgtk-4.so.1"
        c:identifier-prefixes="Gtk"
        c:symbol-prefixes="test"
    >
    <constant
            name="DEFAULT_VALUE"
            value="42"
            c:type="CODEGEN_TESTS_DEFAULT_VALUE"
        >
      <doc xml:space="preserve">Default value</doc>
      <type name="gint" c:type="gint" />
    </constant>

    <interface
            name="Renderable"
            c:type="GRenderable"
            glib:type-name="GRenderable"
        >
      <method name="render" c:identifier="test_renderable_render">
        <parameters>
            <instance-parameter name="about" transfer-ownership="none">
            <doc xml:space="preserve">Returns count</doc>
            <type name="Renderable" c:type="GRenderable*" />
            </instance-parameter>
            <parameter name="width" transfer-ownership="none">
              <doc xml:space="preserve">new count</doc>
                <type name="int" c:type="int" />
             </parameter>
        </parameters>
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="char*" />
        </return-value>
      </method>
    </interface>
    <class name="Impl" c:type="GImpl" glib:type-name="GImpl">
      <doc xml:space="preserve" />
      <implements name="Renderable" />
      <constructor name="new" c:identifier="test_new">
        <doc xml:space="preserve">Creates a new `Impl`.</doc>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve">a newly created `Impl`</doc>
          <type name="Impl" c:type="GImpl*" />
        </return-value>
      </constructor>

      <constructor
                name="with_count"
                c:identifier="test_new_from_count"
                throws="1"
            >
        <doc
                    xml:space="preserve"
                >Creates a new `Impl` with a count (has to be non-negative).</doc>
        <parameters>
        <parameter name="count" transfer-ownership="none">
          <doc xml:space="preserve">new count</doc>
            <type name="gint" c:type="gint" />
          </parameter>
        </parameters>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve">a newly created `Impl`</doc>
          <type name="Impl" c:type="GImpl*" />
        </return-value>
      </constructor>

      <constructor name="with_title" c:identifier="test_new_from_string">
        <doc xml:space="preserve">Creates a new `Impl` with a title.</doc>
        <parameters>
        <parameter name="title" transfer-ownership="none">
          <doc xml:space="preserve">new title</doc>
            <type name="utf8" c:type="char*" />
          </parameter>
        </parameters>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve">a newly created `Impl`</doc>
          <type name="Impl" c:type="GImpl*" />
        </return-value>
      </constructor>
      <method name="get_count" c:identifier="test_get_count">
        <parameters>
            <instance-parameter name="about" transfer-ownership="none">
            <doc xml:space="preserve">Returns count</doc>
            <type name="Impl" c:type="GImpl*" />
            </instance-parameter>
        </parameters>
        <return-value transfer-ownership="none">
          <type name="int" c:type="int" />
        </return-value>
      </method>
      <method name="sqrt_count" c:identifier="test_sqrt_count" throws="1">
        <parameters>
            <instance-parameter name="about" transfer-ownership="none">
            <doc xml:space="preserve">Returns count</doc>
            <type name="Impl" c:type="GImpl*" />
            </instance-parameter>
        </parameters>
        <return-value transfer-ownership="none">
          <type name="int" c:type="int" />
        </return-value>
      </method>
      <method name="get_title" c:identifier="test_get_title">
        <return-value transfer-ownership="none">
            <type name="utf8" c:type="char*" />
        </return-value>
        <parameters>
          <instance-parameter name="about" transfer-ownership="none">
            <doc xml:space="preserve">Returns title</doc>
            <type name="Impl" c:type="GImpl*" />
          </instance-parameter>
        </parameters>
      </method>
      <method name="get_flags" c:identifier="test_get_flags">
      <return-value transfer-ownership="none">
        <array c:type="const char**">
            <type name="utf8" c:type="char*" />
          </array>
        </return-value>
        <parameters>
          <instance-parameter name="about" transfer-ownership="none">
            <doc xml:space="preserve">A `GtkAboutDialog`</doc>
            <type name="Impl" c:type="GImpl*" />
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_options" c:identifier="test_set_options">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void" />
        </return-value>
        <parameters>
          <instance-parameter name="about" transfer-ownership="none">
            <doc xml:space="preserve">A `GtkAboutDialog`</doc>
            <type name="Impl" c:type="GImpl*" />
          </instance-parameter>
          <parameter name="count" transfer-ownership="none">
            <doc xml:space="preserve">The name of the section</doc>
            <type name="int" c:type="int" />
          </parameter>
          <parameter name="title" transfer-ownership="none">
            <doc xml:space="preserve">new title</doc>
            <type name="utf8" c:type="char*" />
          </parameter>
          <parameter name="flags" transfer-ownership="none">
            <array c:type="const char**">
              <type name="utf8" c:type="char*" />
            </array>
          </parameter>
        </parameters>
      </method>

      <function name="add_prefix" c:identifier="test_concat_title">
        <doc xml:space="preserve">Adds a prefix to every string in a list</doc>
        <return-value transfer-ownership="none">
            <array c:type="const char**">
                <type name="utf8" c:type="char*" />
            </array>
        </return-value>
        <parameters>
            <parameter name="prefix" transfer-ownership="none">
            <doc xml:space="preserve">new title</doc>
            <type name="utf8" c:type="char*" />
            </parameter>

            <parameter name="strings" transfer-ownership="none">
                <array c:type="const char**">
                    <type name="utf8" c:type="char*" />
                </array>
            </parameter>
        </parameters>
      </function>
    </class>
 </namespace>
</repository>
